{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLoginIsAccountWide",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyToAstraeaRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-2:793140950071:repository/astraea-gate",
        "arn:aws:ecr:us-east-2:793140950071:repository/astraea-portal"
      ]
    },
    {
      "Sid": "ListingServicesHasNoResourceScope",
      "Effect": "Allow",
      "Action": "apprunner:ListServices",
      "Resource": "*"
    },
    {
      "Sid": "DeployOnlyTheseTwoServices",
      "Effect": "Allow",
      "Action": [
        "apprunner:DescribeService",
        "apprunner:UpdateService",
        "apprunner:StartDeployment",
        "apprunner:ListOperations"
      ],
      "Resource": [
        "arn:aws:apprunner:us-east-2:793140950071:service/astraea-gate/*",
        "arn:aws:apprunner:us-east-2:793140950071:service/astraea-portal/*"
      ]
    },
    {
      "Sid": "UpdateServiceMustPassTheEcrAccessRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::793140950071:role/astraea-apprunner-ecr-access",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "build.apprunner.amazonaws.com" }
      }
    },
    {
      "Sid": "SyncOnlyTheReconBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::astraea-recon-793140950071"
    },
    {
      "Sid": "ObjectsInTheReconBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::astraea-recon-793140950071/*"
    }
  ]
}
