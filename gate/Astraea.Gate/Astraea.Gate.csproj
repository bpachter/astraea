<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fitted by the portal's calibrate_confidence command; optional. -->
    <Content Update="calibration.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned, not floating. These were `*`, which resolved the AWS package to
         1.2.0 — frozen since 2022 — against an SDK that floated to 1.17.0. The
         old package's AddXRayTraceId() no longer hooked id generation, so the
         gate emitted random trace ids instead of the epoch-prefixed ids X-Ray
         requires, and X-Ray discards those without reporting an error. The
         service was healthy and exporting spans the whole time; they simply
         never arrived. Version drift is a silent-failure vector here. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.AWS" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
  </ItemGroup>

</Project>
