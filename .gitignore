# .NET build output. Scoped to gate/ deliberately: a bare `bin/` also matches
# flywheel/bin/, which holds the CDK app's entry point — CI caught that only
# because synthesis failed on a file that exists locally and was never
# committed.
gate/**/bin/
gate/**/obj/
*.user
.vs/

# Node / recon viewer
node_modules/
recon/dist/
# Private graph instances (private briefings, client work) — served in dev by
# the vite private-graphs middleware, never present in builds.
recon/graphs-local/

# Python
__pycache__/
*.pyc
.venv/
db.sqlite3
staticfiles/

# OS / editor
.DS_Store
Thumbs.db

# CDK
flywheel/cdk.out/
flywheel/node_modules/
